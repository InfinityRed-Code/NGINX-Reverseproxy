#!/usr/bin/env bash
# NRP WireGuard site install script
# Site   : {{.Name}}
# Subnet : {{.Subnet}}
# Hub    : {{.OverlayCIDR}}
# LAN    : {{if .LANCIDR}}{{.LANCIDR}}{{else}}(nicht gesetzt){{end}}
# Generated by: nrp site install-script
#
# Dieses Script enthaelt den Preshared Key der Site - vertraulich behandeln.
set -euo pipefail

echo "=== NRP Site Installer: {{.Name}} ==="

# -- 1. Install WireGuard ---------------------------------------------------
echo "[1/6] Installing WireGuard..."
{{- if or (eq .OS "debian") (eq .OS "ubuntu")}}
apt-get update -qq && apt-get install -y wireguard
{{- else if eq .OS "alpine"}}
apk add --no-cache wireguard-tools
{{- else}}
if command -v apt-get &>/dev/null; then
    apt-get update -qq && apt-get install -y wireguard
elif command -v apk &>/dev/null; then
    apk add --no-cache wireguard-tools
else
    echo "Unsupported package manager - install wireguard-tools manually" >&2
    exit 1
fi
{{- end}}

# -- 2. Enable IP forwarding ------------------------------------------------
echo "[2/6] Enabling IP forwarding..."
sysctl -w net.ipv4.ip_forward=1
echo "net.ipv4.ip_forward = 1" > /etc/sysctl.d/99-nrp-forwarding.conf

# -- 3. Generate key pair ---------------------------------------------------
echo "[3/6] Generating key pair..."
PRIVATE_KEY=$(wg genkey)
PUBLIC_KEY=$(echo "$PRIVATE_KEY" | wg pubkey)

# -- 4. Write WireGuard config ----------------------------------------------
echo "[4/6] Writing /etc/wireguard/{{.Iface}}.conf..."
mkdir -p /etc/wireguard
umask 077
cat > /etc/wireguard/{{.Iface}}.conf << WGEOF
[Interface]
Address = {{.ConnectorIP}}/{{.Prefix}}
PrivateKey = $PRIVATE_KEY

[Peer]
PublicKey = {{.HubPublic}}
Endpoint = {{.Endpoint}}
AllowedIPs = {{.OverlayCIDR}}
{{- if .PSK}}
PresharedKey = {{.PSK}}
{{- end}}
PersistentKeepalive = 25
WGEOF
chmod 600 /etc/wireguard/{{.Iface}}.conf

# -- 5. Enable and start tunnel ---------------------------------------------
echo "[5/6] Starting WireGuard tunnel..."
if command -v systemctl &>/dev/null; then
    systemctl enable --now wg-quick@{{.Iface}}
else
    wg-quick up {{.Iface}}
fi

# -- 6. Set up NAT masquerade (LAN traffic forwarding) ------------------------
echo "[6/6] Configuring NAT masquerade..."
LAN_IFACE=$(ip route show default | awk '/^default/ {print $5}' | head -1)
if [ -z "$LAN_IFACE" ]; then
    echo "  Warning: could not detect LAN interface - skipping NAT setup"
    echo "  Run manually: nft add rule ip nat POSTROUTING ip saddr {{.OverlayCIDR}} oif <LAN_IFACE> masquerade"
else
    echo "  Detected LAN interface: $LAN_IFACE"
    if command -v nft &>/dev/null; then
        nft add table ip nat 2>/dev/null || true
        nft add chain ip nat POSTROUTING '{ type nat hook postrouting priority srcnat; policy accept; }' 2>/dev/null || true
        nft add rule ip nat POSTROUTING ip saddr {{.OverlayCIDR}} oif "$LAN_IFACE" masquerade 2>/dev/null || true
        nft list ruleset > /etc/nftables.conf
        systemctl enable nftables 2>/dev/null || true
        echo "  NAT masquerade configured via nftables"
    elif command -v iptables &>/dev/null; then
        iptables -t nat -C POSTROUTING -s {{.OverlayCIDR}} -o "$LAN_IFACE" -j MASQUERADE 2>/dev/null || \
            iptables -t nat -A POSTROUTING -s {{.OverlayCIDR}} -o "$LAN_IFACE" -j MASQUERADE
        if command -v iptables-save &>/dev/null; then
            iptables-save > /etc/iptables/rules.v4 2>/dev/null || \
            iptables-save > /etc/iptables.rules 2>/dev/null || true
        fi
        echo "  NAT masquerade configured via iptables"
    else
        echo "  Warning: neither nft nor iptables found - NAT not configured"
        echo "  Install nftables or iptables and re-run this section manually"
    fi
fi

echo ""
echo "=================================================================="
echo "  IMPORTANT: Register this site's public key on the NRP hub!"
echo "=================================================================="
echo ""
echo "  Site public key: $PUBLIC_KEY"
echo ""
echo "  Run on the hub:"
echo "  docker exec nrp nrp site set-pubkey {{.Name}} $PUBLIC_KEY"
echo ""
echo "  Then verify with:"
echo "  docker exec nrp nrp site show {{.Name}} --live"

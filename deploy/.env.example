# Unveränderlichen Tag oder Digest pinnen, nie "latest" (rewrite.md 4.7)
NRP_VERSION=v3.0.0

# Öffentlicher WireGuard-Endpoint, wie ihn die Sites erreichen (Install-Script)
NRP_PUBLIC_ENDPOINT=proxy.example.com:51820
NRP_WG_PORT=51820                 # nach einem v2-Import den uebernommenen Port eintragen (nrp status)
NRP_WIREGUARD_ENABLED=true

# SANs des API-Serverzertifikats (bei Aenderung wird das Server-Zertifikat neu ausgestellt)
NRP_API_SANS=proxy.example.com,10.240.0.1,127.0.0.1

# ACME: für Tests die Staging-CA verwenden
# NRP_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
NRP_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
NRP_ACME_EMAIL=

NRP_LOG_LEVEL=info

# Nur mit `docker compose --profile crowdsec up -d`
CROWDSEC_VERSION=v1.6.8

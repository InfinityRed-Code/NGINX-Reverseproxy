# Gepinnte Versionen für das NRP-Image. Wird von Renovate gepflegt (renovate.json)
# und in CI als Build-Argumente übergeben:
#   docker build $(sed -e '/^#/d' -e '/^$/d' -e 's/^/--build-arg /' versions.env) -f docker/Dockerfile .

# Basis-Images, immer mit Digest
DEBIAN_IMAGE=debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
GO_IMAGE=golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d

# nginx: nur Stable-Linie (gerade Minor-Version)
NGINX_VERSION=1.30.6
NGINX_SHA256=3cf46f5ed7504d460125866b7bea99fb357f31d887e2e63b35503310e9b8b6c8

# Coraza: coraza-nginx v0.23.0 verlangt libcoraza >= 1.8.0
LIBCORAZA_REF=v1.8.1
CORAZA_NGINX_REF=v0.23.0

# OWASP Core Rule Set
CRS_REF=v4.30.0

# s6-overlay
S6_OVERLAY_VERSION=3.2.3.2
S6_OVERLAY_SHA256_NOARCH=5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12
S6_OVERLAY_SHA256_X86_64=e6befcc96a437a3831386ecfc51808c5d3e939dc5fe3c02ae9284599e8aa2408
S6_OVERLAY_SHA256_AARCH64=b17f17a82e7a515c682a91edaf2ffdabb73f891981b6c1fd712115693a2f8b4c
